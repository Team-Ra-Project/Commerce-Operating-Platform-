DB_URL=jdbc:mysql://localhost:3306/commerce_operating_platform?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=Tanvi9903@
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
JWT_INVITE_DAYS=7

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
EXPOSE_VERIFICATION_TOKEN=false

# Encrypts marketplace_connection.credential_ref (AES-256-GCM) so stored marketplace API keys/secrets/OAuth
# tokens are never persisted in plaintext. Replace with a long random value in every real deployment.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-characters

# SMTP configuration.
# Leave these blank when testing locally without email — MailService degrades
# gracefully (invitation emails are skipped, not a startup failure) whenever
# SMTP_HOST/SMTP_USERNAME aren't set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=hello.radigtalstudio@gmail.com
SMTP_PASSWORD=sbqjrnitipompjuc
SMTP_AUTH=true
SMTP_STARTTLS=true

MAIL_FROM=hello.radigtalstudio@gmail.com
MAIL_FROM_NAME=RA Studio Commerce Platform

# URL where your frontend is running.
PUBLIC_APP_URL=http://localhost:5500

# Local testing: invitation link is returned in the API response.
# Production: set this to false after SMTP is configured.
EXPOSE_INVITATION_LINK=true

# Phase 6 (Product Management): where uploaded product images are stored on
# disk. Defaults to ./uploads relative to where the backend process runs.
UPLOADS_DIR=./uploads

# Phase 18 (WhatsApp Infrastructure). Leave WHATSAPP_MODE=MOCK for local
# testing — no credentials needed at all. Set to REAL and fill in the four
# values below only once you have a real Meta WhatsApp Business/Cloud API
# setup (or a BSP exposing a Cloud-API-compatible endpoint).
WHATSAPP_MODE=MOCK
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v19.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Phase 20 (Retention Marketing): how often the campaign step scheduler
# checks for due journey steps, in milliseconds.
RETENTION_SCHEDULER_INTERVAL_MS=60000

# Phase 19 (Message Templates): how often TemplateApprovalPollingJob polls a
# still-pending WhatsApp template's approval status (REAL mode only).
TEMPLATE_APPROVAL_POLL_INTERVAL_MS=300000

# Phase 16 (Business Intelligence): how often BiGeneratorService recomputes
# trend/forecast/recommendation insights for every organization, in milliseconds.
BI_SCHEDULER_INTERVAL_MS=1800000

# Phase 22 (Bulk Sharing / Broadcast): batch size and pause between batches
# BulkSendService uses to respect WhatsApp/ESP rate limits on a large send.
BULK_SEND_BATCH_SIZE=20
BULK_SEND_BATCH_DELAY_MS=1000